<?xml version="1.0" encoding="utf-8"?>
<!-- Invisible tap target over the brightness bar; shows a ripple when pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
