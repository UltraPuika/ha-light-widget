<?xml version="1.0" encoding="utf-8"?>
<!-- Brightness tile: track, remembered brightness while off (secondary progress), current brightness. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/tile_track" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <solid android:color="@color/tile_restore" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <solid android:color="@color/tile_fill" />
            </shape>
        </scale>
    </item>
</layer-list>
