<?xml version="1.0" encoding="utf-8"?>
<!-- View ids must stay in sync with WidgetRenderer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/power"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/power_bg_off"
            android:contentDescription="@string/cd_turn_on"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_power_off" />

        <!-- Brightness tile: tap anywhere on it to set that brightness. Text on top is not clickable. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:maxHeight="1000dp"
                android:minHeight="0dp"
                android:progress="0"
                android:progressDrawable="@drawable/tile_bar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

            <ImageView
                android:id="@+id/seg_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_10"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_11"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_13"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_14"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_15"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_17"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_18"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            <ImageView
                android:id="@+id/seg_19"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/segment_bg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tile_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/widget_not_configured_title" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                    android:id="@+id/pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tile_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/pct_unknown" />

                    <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tile_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:text="@string/status_loading" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/minus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/minus"
            android:textColor="@color/widget_button_fg"
            android:textSize="20sp" />

        <Button
            android:id="@+id/plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/plus"
            android:textColor="@color/widget_button_fg"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
